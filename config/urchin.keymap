		// 	bindings = <&kp>, <&kp>;
		// 	hold-trigger-key-positions = < 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 33 16 17 18 19 >; // 32 33
		// 	hold-trigger-on-release;
		// };
	};

	combos {
		compatible = "zmk,combos";
		combo_tab {
			bindings = <&kp TAB>;
			key-positions = <0 10>;
			timeout-ms = <25>;
		};
		// combo_mod_raise {
		// 	timeout-ms = <25>;
		// 	key-positions = <30 31>;
		// 	bindings = <&mo MOD_RAISE>;
		// };
		// combo_mod_lower {
		// 	timeout-ms = <25>;
		// 	key-positions = <32 33>;
		// 	bindings = <&mo MOD_LOWER>;
		// };
